<Window x:Class="ClaudeIndicator.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Indicator — Histórico"
        Width="780" Height="620"
        MinWidth="640" MinHeight="500"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Closed="OnClosed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: barra + período -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Barra:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <RadioButton x:Name="SerSession" GroupName="Serie" Content="Sessão" Margin="10,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="SerWeekly" GroupName="Serie" Content="Semanal" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="SerFable" GroupName="Serie" Content="Fable 5" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Período:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <RadioButton x:Name="Rng24h" GroupName="Rng" Content="24 horas" Margin="10,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="Rng7d" GroupName="Rng" Content="7 dias" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="Rng30d" GroupName="Rng" Content="30 dias" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="RngAll" GroupName="Rng" Content="Tudo" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Destaques -->
        <Grid Grid.Row="1" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="StatHour" Text="—" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="última hora" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,14" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="StatDay" Text="—" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="últimas 24 horas" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,14" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="StatRange" Text="—" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatRangeCaption" Text="no período" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Nível ao longo do tempo -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,0,20,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="LineTitle" Text="Nível da barra (%)" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LineHover" Text="" HorizontalAlignment="Right" VerticalAlignment="Top"
                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
                <Canvas x:Name="LineCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True"
                        SizeChanged="OnCanvasSizeChanged" MouseMove="OnLineMouseMove" MouseLeave="OnLineMouseLeave"/>
            </Grid>
        </Border>

        <!-- Consumo por intervalo -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="20,7,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="BarsTitle" Text="Consumo por hora (pts do limite)" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                <Canvas x:Name="BarsCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True"
                        SizeChanged="OnCanvasSizeChanged"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="pts = pontos percentuais do limite. O histórico é gravado enquanto o app está aberto; intervalos com o app fechado não entram na soma. Quedas no gráfico de nível são renovações do limite."/>
            </Grid>
        </Border>
    </Grid>
</Window>
