<Window x:Class="ClaudeIndicator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Indicator"
        Width="1020" Height="720"
        MinWidth="860" MinHeight="560"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Closed="OnClosed">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navegação -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Claude Indicator" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource Hint}" FontSize="11" Margin="17,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOverview" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Tag="&#xE80F;" Content="Visão geral" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Tag="&#xE81C;" Content="Histórico" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavProjects" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Tag="&#xE8B7;" Content="Projetos" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavPerformance" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Tag="&#xE9D9;" Content="Desempenho do PC" Checked="OnNavChanged"/>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Tag="&#xE713;" Content="Configurações" Checked="OnNavChanged"/>
                </StackPanel>

                <!-- Estado da conexão -->
                <Border Grid.Row="2" Padding="18,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="carregando…" Style="{StaticResource Hint}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock x:Name="AccountLabel" Style="{StaticResource Hint}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="26,18,20,14">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="Visão geral" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <!-- com rótulo, e não só ícone: dois ícones lado a lado não dizem o que fazem -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="BtnRefresh" Content="Atualizar" Click="OnRefreshClick"
                                Padding="12,6" FontSize="12"
                                ToolTip="Consultar o consumo na API agora"/>
                        <Button x:Name="BtnGadget" Content="Mostrar gadget" Click="OnToggleGadgetClick"
                                Padding="12,6" FontSize="12" Margin="8,0,0,0"
                                ToolTip="Liga e desliga a janelinha flutuante"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
