<Window x:Class="ClaudeIndicator.Views.GadgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Indicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="80" Top="80"
        Loaded="OnLoaded">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="VersionItem" IsEnabled="False"/>
            <Separator/>
            <MenuItem Header="Atualizar agora" Click="OnRefreshClick"/>
            <MenuItem Header="Abrir painel…" Click="OnDashboardClick"/>
            <MenuItem Header="Histórico de consumo…" Click="OnHistoryClick"/>
            <MenuItem Header="Consumo por projeto…" Click="OnProjectsClick"/>
            <MenuItem Header="Configurações…" Click="OnSettingsClick"/>
            <Separator/>
            <MenuItem Header="Ocultar gadget" Click="OnHideClick"/>
            <MenuItem Header="Sair" Click="OnExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Border x:Name="Root" Width="214"
                Background="#F2201F1E"
                CornerRadius="12"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Padding="13,10,13,12"
                MouseEnter="OnRootMouseEnter"
                MouseLeave="OnRootMouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#FF000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- so o cabecalho arrasta: no rodape o arraste atrapalhava a leitura da faixa -->
                <Grid x:Name="DragHandle" Margin="0,0,0,10" Background="Transparent"
                      MouseLeftButtonDown="OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Claude" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0">
                        <Button Content="&#x21BB;" Style="{StaticResource IconButton}" Click="OnRefreshClick" ToolTip="Atualizar"/>
                        <Button Content="&#x2699;" Style="{StaticResource IconButton}" Click="OnSettingsClick" ToolTip="Configurações"/>
                        <Button x:Name="CloseBtn" Content="&#x2715;" Style="{StaticResource IconButton}" Click="OnHideClick" ToolTip="Ocultar"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="BarsPanel"/>

                <!-- Sensores do computador. Painel próprio, e não dentro do BarsPanel, para a
                     leitura de dois em dois segundos redesenhar só esta parte: refazer os limites
                     junto fecharia o tooltip que estivesse aberto neles. -->
                <StackPanel x:Name="HardwarePanel"/>

                <!-- rodape: texto a esquerda, linha do tempo das ultimas consultas a direita -->
                <Grid Margin="0,5,0,0">
                    <TextBlock x:Name="FooterText" Style="{StaticResource Hint}" FontSize="10.5"
                               VerticalAlignment="Center" Margin="0"/>
                    <StackPanel x:Name="CallsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
