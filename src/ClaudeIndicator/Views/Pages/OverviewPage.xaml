<UserControl x:Class="ClaudeIndicator.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,0,20,20">
        <StackPanel>

            <!-- Aviso quando os dados estão velhos ou houve erro -->
            <Border x:Name="AlertBox" Visibility="Collapsed" CornerRadius="9" Padding="14,11"
                    Margin="0,0,0,16" Background="#22E8B04B" BorderBrush="#55E8B04B" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock x:Name="AlertText" TextWrapping="Wrap" FontSize="12.5" MaxWidth="620"/>
                </StackPanel>
            </Border>

            <!-- Barras principais -->
            <ItemsControl x:Name="BarsHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Ritmo de consumo -->
            <TextBlock Text="Ritmo de consumo" Style="{StaticResource Title}" Margin="2,20,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock x:Name="StatHour" Text="—" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="na última hora" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock x:Name="StatDay" Text="—" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="nas últimas 24 horas" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock x:Name="StatProjection" Text="—" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatProjectionCaption" Text="projeção até a renovação"
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Últimas 24 horas -->
            <Border Style="{StaticResource Card}" Margin="0,6,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Últimas 24 horas" Style="{StaticResource Title}" Margin="0"/>
                        <TextBlock x:Name="SparkCaption" Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0"/>
                    </Grid>
                    <Canvas x:Name="SparkCanvas" Height="92" Background="Transparent"
                            SizeChanged="OnSparkSizeChanged"/>
                </StackPanel>
            </Border>

            <!-- Top projetos -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Onde foi gasto nesta semana (% do consumo)" Style="{StaticResource Title}" Margin="0"/>
                        <Button Content="Ver todos" Click="OnSeeProjectsClick" Padding="10,4" FontSize="11.5"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <StackPanel x:Name="TopProjectsPanel"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
