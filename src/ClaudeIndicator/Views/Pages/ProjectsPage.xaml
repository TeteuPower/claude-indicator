<UserControl x:Class="ClaudeIndicator.Views.Pages.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">

    <Grid Margin="26,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Período" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PerWeek" GroupName="Per" Style="{StaticResource Segment}" Content="Semana atual" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="Per24h" GroupName="Per" Style="{StaticResource Segment}" Content="24 horas" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="Per30d" GroupName="Per" Style="{StaticResource Segment}" Content="30 dias" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="PerAll" GroupName="Per" Style="{StaticResource Segment}" Content="Tudo" Checked="OnFilterChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Modelos" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ScopeAll" GroupName="Scope" Style="{StaticResource Segment}" Content="Todos" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="ScopeFable" GroupName="Scope" Style="{StaticResource Segment}" Content="Só Fable 5" Checked="OnFilterChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Resumo -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="SummaryLine" FontSize="14"/>
                <TextBlock x:Name="SummaryHint" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Projetos -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProjectsTitle" Text="Projetos" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="ProjectsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Prompts -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,7,0,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="PromptsTitle" Text="Prompts" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SortRecent" GroupName="Sort" Style="{StaticResource Segment}" Content="Mais recentes" Checked="OnSortChanged"/>
                            <RadioButton x:Name="SortCost" GroupName="Sort" Style="{StaticResource Segment}" Content="Mais caros" Checked="OnSortChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PromptsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Rodapé -->
        <Grid Grid.Row="4" Margin="0,4,0,14">
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
            <Button Content="Reler transcrições" HorizontalAlignment="Right" Padding="10,4" FontSize="11.5"
                    Click="OnRescanClick"/>
        </Grid>
    </Grid>
</UserControl>
