<UserControl x:Class="ClaudeIndicator.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">

    <Grid Margin="26,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Barra" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SerSession" GroupName="Serie" Style="{StaticResource Segment}" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="SerWeekly" GroupName="Serie" Style="{StaticResource Segment}" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="SerFable" GroupName="Serie" Style="{StaticResource Segment}" Checked="OnFilterChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Período" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Rng24h" GroupName="Rng" Style="{StaticResource Segment}" Content="24 horas" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="Rng7d" GroupName="Rng" Style="{StaticResource Segment}" Content="7 dias" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="Rng30d" GroupName="Rng" Style="{StaticResource Segment}" Content="30 dias" Checked="OnFilterChanged"/>
                        <RadioButton x:Name="RngAll" GroupName="Rng" Style="{StaticResource Segment}" Content="Tudo" Checked="OnFilterChanged"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Destaques -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14" Padding="15,11">
                <StackPanel>
                    <TextBlock x:Name="StatHour" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="última hora" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,14" Padding="15,11">
                <StackPanel>
                    <TextBlock x:Name="StatDay" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="últimas 24 horas" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,14" Padding="15,11">
                <StackPanel>
                    <TextBlock x:Name="StatRange" Text="—" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatRangeCaption" Text="no período" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Nível ao longo do tempo -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="LineTitle" Text="Nível da barra (%)" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LineHover" HorizontalAlignment="Right" VerticalAlignment="Top"
                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
                <Canvas x:Name="LineCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True"
                        SizeChanged="OnCanvasSizeChanged" MouseMove="OnLineMouseMove" MouseLeave="OnLineMouseLeave"/>
            </Grid>
        </Border>

        <!-- Consumo por intervalo -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,7,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="BarsTitle" Text="Consumo por hora" Style="{StaticResource Title}" Margin="0,0,0,6"/>
                <Canvas x:Name="BarsCanvas" Grid.Row="1" Background="Transparent" ClipToBounds="True"
                        SizeChanged="OnCanvasSizeChanged"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Os valores são quanto do limite foi consumido no intervalo — somar 3% aqui significa que a barra subiu 3 pontos. O histórico é gravado enquanto o app está aberto; intervalos com o app fechado não entram na soma. Quedas no gráfico de nível são renovações do limite."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
