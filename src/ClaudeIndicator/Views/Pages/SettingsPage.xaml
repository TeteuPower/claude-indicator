<UserControl x:Class="ClaudeIndicator.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Categorias -->
        <Border Grid.Row="0" Style="{StaticResource SegmentGroup}" Margin="26,0,20,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabDisplay" GroupName="Tab" Style="{StaticResource Segment}" Content="Onde exibir" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabBars" GroupName="Tab" Style="{StaticResource Segment}" Content="Barras" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabRate" GroupName="Tab" Style="{StaticResource Segment}" Content="Ritmo" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabAccount" GroupName="Tab" Style="{StaticResource Segment}" Content="Conta" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabSystem" GroupName="Tab" Style="{StaticResource Segment}" Content="Sistema" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabData" GroupName="Tab" Style="{StaticResource Segment}" Content="Dados" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabAdvanced" GroupName="Tab" Style="{StaticResource Segment}" Content="Avançado" Checked="OnTabChanged"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,20,10">
            <Grid>

                <!-- ============ Onde exibir ============ -->
                <StackPanel x:Name="PanelDisplay">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Onde os indicadores aparecem" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Pode usar mais de um ao mesmo tempo."/>

                            <CheckBox x:Name="ChkTray" Style="{StaticResource Switch}" Content="Ícone na bandeja do sistema"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="As barras são desenhadas no próprio ícone, ao lado do relógio."/>

                            <CheckBox x:Name="ChkTaskbar" Style="{StaticResource Switch}" Content="Painel na barra de tarefas"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Ocupa o espaço livre da própria barra, com rótulo, porcentagem e barra de cada limite."/>

                            <CheckBox x:Name="ChkGadget" Style="{StaticResource Switch}" Content="Gadget flutuante"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Janela arrastável que fica por cima dos outros aplicativos."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ícone da bandeja" Style="{StaticResource Title}"/>
                            <TextBlock Text="Disposição das barras" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OrientVertical" GroupName="TrayOrient" Style="{StaticResource Segment}" Content="Vertical (colunas)"/>
                                    <RadioButton x:Name="OrientHorizontal" GroupName="TrayOrient" Style="{StaticResource Segment}" Content="Horizontal (linhas)"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Com duas ou três barras a horizontal costuma ser mais legível em 16 px. Com uma barra só, o ícone mostra a porcentagem em número."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Painel na barra de tarefas" Style="{StaticResource Title}"/>

                            <TextBlock Text="Posição" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TbLeft" GroupName="TbAnchor" Style="{StaticResource Segment}" Content="À esquerda"/>
                                    <RadioButton x:Name="TbRight" GroupName="TbAnchor" Style="{StaticResource Segment}" Content="Junto ao relógio"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distância da borda" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbOffset" Grid.Column="1" Minimum="0" Maximum="400" Value="8"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblTbOffset" Grid.Column="2" Text="8 px" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbScale" Grid.Column="1" Minimum="0.8" Maximum="1.6" Value="1"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblTbScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fundo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbOpacity" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblTbOpacity" Grid.Column="2" Text="0%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <TextBlock Text="Estilo" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="EstiloContorno" GroupName="PanelStyle" Style="{StaticResource Segment}"
                                                 Content="Com contorno"/>
                                    <RadioButton x:Name="EstiloLeve" GroupName="PanelStyle" Style="{StaticResource Segment}"
                                                 Content="Sem contorno"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Com contorno, cada letra ganha um traço escuro em volta e a trilha das barras fica escura com borda clara: lê sobre qualquer papel de parede, inclusive claro. Sem contorno é o visual mais leve, que combina com papel escuro. Vale para os dois painéis da barra e para o indicador no jogo."/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="O Windows 11 não permite embutir componentes na barra de tarefas, então o painel é uma faixa posicionada sobre o espaço livre dela — ele acompanha mudanças de tamanho e some quando um aplicativo em tela cheia está na frente. Fundo em 0% deixa a barra do Windows aparecer atrás."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Indicadores por cima do jogo" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Escolha a janela do jogo e o app desenha FPS e os sensores por cima dela. A medição de quadros usa o rastreamento do próprio Windows — o mesmo caminho do PresentMon: nada é injetado no jogo e nada é lido da memória dele, que é o que faz anticheat reclamar."/>

                            <CheckBox x:Name="ChkOverlay" Style="{StaticResource Switch}" Content="Mostrar indicadores no jogo"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="O estilo do texto é o mesmo dos painéis da barra — a opção fica em “Painel na barra de tarefas”."/>

                            <TextBlock Text="Qual é o jogo" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Abra o jogo primeiro e escolha a janela dele aqui. Escolher à mão sempre funciona; adivinhar não, porque em janela sem bordas um jogo é indistinguível de qualquer outra janela."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="12,9"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="GameTargetText" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Button x:Name="BtnPickGame" Grid.Column="1" Content="Escolher janela…"
                                        Click="OnPickGameClick" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnClearGame" Grid.Column="2" Content="Limpar"
                                        Click="OnClearGameClick" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <CheckBox x:Name="ChkOverlayNoFocus" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                      Content="Mostrar mesmo quando o jogo não está em primeiro plano"/>

                            <TextBlock Text="Nunca mostrar nestes" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Vale para quando o app está adivinhando. Uma planilha maximizada cobre o monitor igualzinho a um jogo — aqui você diz quais aplicativos devem ser ignorados."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="4" MinHeight="86">
                                    <ListBox x:Name="ListaExcecoes" Background="Transparent" BorderThickness="0"
                                             MaxHeight="130" Foreground="{StaticResource TextBrush}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Button Content="Adicionar…" Click="OnAddExceptionClick" MinWidth="112"/>
                                    <Button x:Name="BtnRemoverExcecao" Content="Remover" Click="OnRemoveExceptionClick"
                                            Margin="0,8,0,0" MinWidth="112"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="OverlayStatus" Background="{StaticResource BgBrush}" CornerRadius="9"
                                    Padding="14,11" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="OverlayStatusText" Style="{StaticResource Hint}" FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="BtnOverlayElevate" Content="Reiniciar como administrador"
                                            Click="OnElevateClick" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Onde na tela" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="180"
                                         HorizontalAlignment="Left"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distância da borda" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOverlayMargin" Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="2"
                                        IsSnapToTickEnabled="True" Value="18" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOverlayMargin" Grid.Column="2" Text="18 px" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOverlayScale" Grid.Column="1" Minimum="0.7" Maximum="2.5" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" Value="1" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOverlayScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fundo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOverlayOpacity" Grid.Column="1" Minimum="0.1" Maximum="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" Value="0.7" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOverlayOpacity" Grid.Column="2" Text="70%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <TextBlock Text="O que mostrar no jogo" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                            <CheckBox x:Name="ChkOvFps" Style="{StaticResource Switch}" Content="FPS"/>
                            <CheckBox x:Name="ChkOvFrameTime" Style="{StaticResource Switch}"
                                      Content="Tempo de quadro e 1% low" Margin="27,9,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="O 1% low é o ritmo nos 1% de quadros mais lentos — é ele que denuncia engasgo que a média esconde."/>
                            <CheckBox x:Name="ChkOvCpu" Style="{StaticResource Switch}" Content="CPU"/>
                            <CheckBox x:Name="ChkOvGpu" Style="{StaticResource Switch}" Content="GPU"/>
                            <CheckBox x:Name="ChkOvRam" Style="{StaticResource Switch}" Content="Memória"/>
                            <CheckBox x:Name="ChkOvClaude" Style="{StaticResource Switch}" Content="Limites da assinatura Claude"/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Text="Em janela sem bordas e em tela cheia com as otimizações do Windows ligadas (o padrão no Windows 11) o bloco aparece normalmente. Em tela cheia exclusiva de verdade o jogo é dono da tela e nenhuma janela sobrepõe — nesse caso, alternar o jogo para “tela cheia em janela” resolve."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Painel do computador na barra de tarefas" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Um segundo painel com CPU, GPU e memória, do lado oposto ao da IA — assim cada bloco tem lugar fixo e você nunca confunde qual é qual."/>

                            <CheckBox x:Name="ChkPcPanel" Style="{StaticResource Switch}" Content="Mostrar o painel do computador"/>

                            <TextBlock Text="Lado" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PcLeft" GroupName="PcAnchor" Style="{StaticResource Segment}" Content="À esquerda"/>
                                    <RadioButton x:Name="PcRight" GroupName="PcAnchor" Style="{StaticResource Segment}" Content="Junto ao relógio"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="O que mostrar" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                            <CheckBox x:Name="ChkPcCpu" Style="{StaticResource Switch}" Content="CPU"/>
                            <CheckBox x:Name="ChkPcCpuSensors" Style="{StaticResource Switch}"
                                      Content="Ler também temperatura e watts da CPU" Margin="27,9,0,0"/>
                            <CheckBox x:Name="ChkPcGpu" Style="{StaticResource Switch}" Content="GPU (uso, temperatura, watts)"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="A GPU entrega tudo sem driver e sem elevação. O uso da CPU e a memória também."/>
                            <CheckBox x:Name="ChkPcRam" Style="{StaticResource Switch}" Content="Memória (uso e GB)"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Leitura a cada" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldPcInterval" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="2" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblPcInterval" Grid.Column="2" Text="2 s" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="9"
                                    Padding="14,11" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ElevationText" Style="{StaticResource Hint}" FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="BtnElevate" Content="Reiniciar como administrador"
                                            Click="OnElevateClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gadget flutuante" Style="{StaticResource Title}"/>

                            <TextBlock Text="Disposição das barras" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="GadgetVertical" GroupName="GadgetOrient" Style="{StaticResource Segment}" Content="Uma por linha"/>
                                    <RadioButton x:Name="GadgetHorizontal" GroupName="GadgetOrient" Style="{StaticResource Segment}" Content="Lado a lado"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacidade" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.3" Maximum="1" Value="0.95"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="95%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldScale" Grid.Column="1" Minimum="0.7" Maximum="2" Value="1"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <CheckBox x:Name="ChkTopmost" Style="{StaticResource Switch}" Content="Sempre por cima"/>
                            <CheckBox x:Name="ChkLocked" Style="{StaticResource Switch}" Content="Travar posição"/>
                            <CheckBox x:Name="ChkShowReset" Style="{StaticResource Switch}" Content="Mostrar horário de renovação"/>

                            <Button Content="Reposicionar no canto inferior direito" Click="OnResetPositionClick"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Ritmo (velocímetro) ============ -->
                <StackPanel x:Name="PanelRate" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Velocímetro de consumo" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Mostra quanto do limite você está gastando por minuto. O meio da escala é o ritmo que o limite aguenta até renovar: ponteiro à esquerda dele significa que dá para seguir assim, à direita significa que vai acabar antes."/>

                            <CheckBox x:Name="ChkRateTaskbar" Style="{StaticResource Switch}" Content="Mostrar no painel da barra de tarefas"/>
                            <CheckBox x:Name="ChkRateGadget" Style="{StaticResource Switch}" Content="Mostrar no gadget flutuante"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="No ícone da bandeja o ritmo aparece ao passar o mouse — no desenho de 16 px não há espaço."/>

                            <TextBlock Text="Ritmo de qual limite" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,5"
                                       Text="Também dá para trocar clicando no próprio velocímetro, na barra de tarefas ou no gadget — o rótulo ao lado dele mostra qual está ativo."/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RateWeekly" GroupName="RateKind" Style="{StaticResource Segment}" Content="Semanal"/>
                                    <RadioButton x:Name="RateSession" GroupName="RateKind" Style="{StaticResource Segment}" Content="Sessão"/>
                                    <RadioButton x:Name="RateFable" GroupName="RateKind" Style="{StaticResource Segment}" Content="Fable 5"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Calcular a média sobre" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Win5" GroupName="RateWin" Style="{StaticResource Segment}" Content="5 min"/>
                                    <RadioButton x:Name="Win20" GroupName="RateWin" Style="{StaticResource Segment}" Content="20 min"/>
                                    <RadioButton x:Name="Win60" GroupName="RateWin" Style="{StaticResource Segment}" Content="1 hora"/>
                                    <RadioButton x:Name="Win1440" GroupName="RateWin" Style="{StaticResource Segment}" Content="24 horas"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Janela curta reage rápido e oscila; janela longa é estável e demora a perceber mudança de ritmo. Só entra tempo com o app aberto — períodos fechados não contam como consumo zero."/>

                            <CheckBox x:Name="ChkTimeProgress" Style="{StaticResource Switch}"
                                      Content="Mostrar o tempo decorrido da janela junto das barras"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Um fio fino sob cada barra marca quanto já passou até a renovação: se ele está à frente do consumo, você gasta mais devagar que o relógio."/>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="16,13" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl x:Name="RatePreviewHost" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="RatePreviewValue" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RatePreviewCaption" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Barras ============ -->
                <StackPanel x:Name="PanelBars" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Quais barras mostrar" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="O texto à direita é o rótulo exibido. Só aparecem as barras que a API devolver."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="ChkSession" Grid.Row="0" Style="{StaticResource Switch}" Content="Sessão (janela de 5 horas)" Margin="0,9,20,0"/>
                                <TextBox x:Name="TxtSessionLabel" Grid.Row="0" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnAnyTextChanged"/>

                                <CheckBox x:Name="ChkWeekly" Grid.Row="1" Style="{StaticResource Switch}" Content="Semanal (todos os modelos)" Margin="0,9,20,0"/>
                                <TextBox x:Name="TxtWeeklyLabel" Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnAnyTextChanged"/>

                                <CheckBox x:Name="ChkFable" Grid.Row="2" Style="{StaticResource Switch}" Content="Semanal do modelo avançado" Margin="0,9,20,0"/>
                                <TextBox x:Name="TxtFableLabel" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnAnyTextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Cores por nível" Style="{StaticResource Title}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Atenção (amarelo)" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldWarn" Grid.Column="1" Minimum="30" Maximum="95" TickFrequency="5"
                                        IsSnapToTickEnabled="True" Value="75" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnWarnChanged"/>
                                <TextBlock x:Name="LblWarn" Grid.Column="2" Text="75%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Alerta (vermelho)" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldAlert" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                                        IsSnapToTickEnabled="True" Value="90" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAlertChanged"/>
                                <TextBlock x:Name="LblAlert" Grid.Column="2" Text="90%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <CheckBox x:Name="ChkNotify" Style="{StaticResource Switch}"
                                      Content="Avisar com notificação ao atingir o alerta"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Prévia" Style="{StaticResource Title}"/>
                            <StackPanel x:Name="PreviewPanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Conta ============ -->
                <StackPanel x:Name="PanelAccount" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="De onde vem o consumo" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" FontSize="12.5"/>

                            <RadioButton x:Name="SrcClaudeCode" GroupName="Src" Margin="0,14,0,0"
                                         Content="Usar o login do Claude Code (recomendado)" Checked="OnSourceChanged"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="Lê o token de %USERPROFILE%\.claude\.credentials.json. O arquivo do Claude Code nunca é alterado."/>

                            <RadioButton x:Name="SrcManual" GroupName="Src" Content="Informar um token manualmente"
                                         Checked="OnSourceChanged"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,6"
                                       Text="Gere com `claude setup-token` e cole abaixo."/>
                            <TextBox x:Name="TxtToken" Margin="27,0,0,0" FontFamily="Consolas" FontSize="11.5"
                                     TextChanged="OnAnyTextChanged"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnTest" Content="Testar conexão" Click="OnTestClick"/>
                                <TextBlock x:Name="TestResult" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" MaxWidth="420"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Sistema ============ -->
                <StackPanel x:Name="PanelSystem" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Inicialização" Style="{StaticResource Title}"/>
                            <CheckBox x:Name="ChkStartup" Style="{StaticResource Switch}" Content="Iniciar junto com o Windows"/>
                            <CheckBox x:Name="ChkStartHidden" Style="{StaticResource Switch}" Content="Ao iniciar, não abrir esta janela"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Consultas à API" Style="{StaticResource Title}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intervalo mínimo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldRefresh" Grid.Column="1" Minimum="60" Maximum="900"
                                        TickFrequency="15" IsSnapToTickEnabled="True" Value="120"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnRefreshIntervalChanged"/>
                                <TextBlock x:Name="LblRefresh" Grid.Column="2" Text="120 s" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="A cadência é fixa: uma consulta por intervalo, sempre, mesmo com o consumo parado. O limite de consultas é da conta inteira e cada sessão do Claude Code aberta consulta o mesmo endpoint — por isso intervalos curtos com várias sessões abertas causam HTTP 429. Se isso acontecer, o app espera o limite passar e volta sozinho; o remédio permanente é aumentar este intervalo."/>

                            <CheckBox x:Name="ChkCallTimeline" Style="{StaticResource Switch}"
                                      Content="Mostrar a linha do tempo das consultas"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Dez pontos no gadget e no painel da barra, um por ciclo do intervalo acima: verde respondeu, âmbar não conseguiu falar por limite, vermelho falhou e o ponto apagado é ciclo sem consulta porque o consumo não mudou. Passar o mouse mostra o horário de cada um."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Dados ============ -->
                <StackPanel x:Name="PanelData" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Histórico de consumo" Style="{StaticResource Title}"/>
                            <RadioButton x:Name="KeepForever" GroupName="Retencao"
                                         Content="Guardar todo o histórico (padrão)" Checked="OnRetentionChanged"/>
                            <RadioButton x:Name="KeepDays" GroupName="Retencao"
                                         Content="Apagar registros antigos automaticamente" Checked="OnRetentionChanged"/>

                            <Grid Margin="27,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblRetentionCaption" Text="Manter os últimos" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldRetention" Grid.Column="1" Minimum="7" Maximum="730" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="31" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnRetentionDaysChanged"/>
                                <TextBlock x:Name="LblRetention" Grid.Column="2" Text="31 dias" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <TextBlock x:Name="HistoryInfo" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Avançado ============ -->
                <StackPanel x:Name="PanelAdvanced" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Diagnóstico" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="O endpoint de uso é interno da Anthropic e pode mudar de nome ou formato. Tudo aqui é ajustável sem recompilar."/>

                            <TextBlock Text="Endpoints consultados (um por linha)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtEndpoints" AcceptsReturn="True" Height="52"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"
                                     TextChanged="OnAnyTextChanged"/>

                            <TextBlock Text="Palavras-chave por barra" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sessão" VerticalAlignment="Center" Grid.Row="0" FontSize="12.5"/>
                                <TextBox x:Name="TxtKwSession" Grid.Row="0" Grid.Column="1" Margin="0,3" TextChanged="OnAnyTextChanged"/>
                                <TextBlock Text="Semanal" VerticalAlignment="Center" Grid.Row="1" FontSize="12.5"/>
                                <TextBox x:Name="TxtKwWeekly" Grid.Row="1" Grid.Column="1" Margin="0,3" TextChanged="OnAnyTextChanged"/>
                                <TextBlock Text="Fable / Opus" VerticalAlignment="Center" Grid.Row="2" FontSize="12.5"/>
                                <TextBox x:Name="TxtKwFable" Grid.Row="2" Grid.Column="1" Margin="0,3" TextChanged="OnAnyTextChanged"/>
                            </Grid>

                            <TextBlock Text="Peso de cada tipo de token no consumo por projeto" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Saída" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtWeightOutput" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Escrita de cache" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtWeightCacheWrite" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                    <TextBlock Text="Leitura de cache" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtWeightCacheRead" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                    <TextBlock Text="Modelos do Fable" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtFableModels" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Entrada é a referência (peso 1). Estes pesos mudam como o consumo é repartido entre projetos, nunca o total medido."/>

                            <TextBlock Text="Resposta bruta da API" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBox x:Name="TxtRaw" AcceptsReturn="True" IsReadOnly="True" Height="150"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11.5"/>
                            <TextBlock x:Name="DiagInfo" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Atualizações" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" FontSize="12.5"/>

                            <CheckBox x:Name="ChkCheckUpdates" Style="{StaticResource Switch}"
                                      Content="Procurar versão nova automaticamente"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Consulta as releases do repositório no máximo uma vez a cada 6 horas."/>

                            <TextBlock Text="Repositório" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBox x:Name="TxtUpdateRepo" FontFamily="Consolas" FontSize="11.5" TextChanged="OnAnyTextChanged"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnCheckUpdate" Content="Procurar agora" Click="OnCheckUpdateClick"/>
                                <Button x:Name="BtnInstallUpdate" Content="Baixar e instalar" Click="OnInstallUpdateClick"
                                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="UpdateResult" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" MaxWidth="360"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Encerrar" Style="{StaticResource Title}"/>
                            <Button Content="Sair do Claude Indicator" Click="OnExitAppClick" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Barra de salvar: só aparece quando há mudança pendente -->
        <Border x:Name="SaveBar" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="26,12,20,12">
            <Grid>
                <TextBlock Text="Há alterações não salvas." VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Descartar" Click="OnCancelClick" Margin="0,0,10,0"/>
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" MinWidth="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
