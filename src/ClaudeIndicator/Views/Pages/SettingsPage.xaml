<UserControl x:Class="ClaudeIndicator.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Navegação agrupada por assunto, e não uma fileira de sete abas soltas. Os grupos contam
            a estrutura do app: o que é da assinatura Claude, o que é do computador, o que é do
            aplicativo em si — quem procura "onde mudo o atalho do jogo?" acha pelo grupo, sem
            precisar adivinhar em qual aba genérica alguém guardou.
        -->
        <Grid Grid.Row="1" Margin="26,0,20,10">
            <Grid.ColumnDefinitions>
                <!-- 186 e nao 168: "Barra do Windows" nao cabia e vinha cortado no meio -->
                <ColumnDefinition Width="186"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,2,14,0">
                <TextBlock Text="CLAUDE" Style="{StaticResource Hint}" FontSize="10.5" Margin="14,4,0,4"/>
                <RadioButton x:Name="TabBars" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE9D2;" Content="Barras" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabRate" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xEC4A;" Content="Ritmo" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabAccount" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE77B;" Content="Conta" Checked="OnTabChanged"/>

                <TextBlock Text="COMPUTADOR" Style="{StaticResource Hint}" FontSize="10.5" Margin="14,14,0,4"/>
                <RadioButton x:Name="TabDisplay" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE7F4;" Content="Painéis" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabDock" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE90C;" Content="Barra própria" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabTaskbar" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE7F4;" Content="Barra do Windows" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabGlass" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE7C4;" Content="Janelas" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabGame" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE7FC;" Content="No jogo" Checked="OnTabChanged"/>

                <TextBlock Text="APLICATIVO" Style="{StaticResource Hint}" FontSize="10.5" Margin="14,14,0,4"/>
                <RadioButton x:Name="TabSystem" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xE713;" Content="Sistema" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabData" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xEA35;" Content="Dados" Checked="OnTabChanged"/>
                <RadioButton x:Name="TabAdvanced" GroupName="Tab" Style="{StaticResource NavItem}"
                             Tag="&#xEC7A;" Content="Avançado" Checked="OnTabChanged"/>
            </StackPanel>

            <ScrollViewer x:Name="PanelScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,10">
            <Grid>

                <!-- ============ Onde exibir ============ -->
                <StackPanel x:Name="PanelDisplay">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Onde os indicadores aparecem" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Pode usar mais de um ao mesmo tempo."/>

                            <CheckBox x:Name="ChkTray" Style="{StaticResource Switch}" Content="Ícone na bandeja do sistema"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="As barras são desenhadas no próprio ícone, ao lado do relógio."/>

                            <CheckBox x:Name="ChkTaskbar" Style="{StaticResource Switch}" Content="Painel na barra de tarefas"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Ocupa o espaço livre da própria barra, com rótulo, porcentagem e barra de cada limite."/>

                            <CheckBox x:Name="ChkGadget" Style="{StaticResource Switch}" Content="Gadget flutuante"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Janela arrastável que fica por cima dos outros aplicativos."/>

                            <TextBlock x:Name="DockTakeoverHint" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="A barra própria está ligada. Estes interruptores são do espaço livre da barra do Windows; o que aparece na barra própria tem interruptor separado, em Barra própria — dá para ter o mesmo painel nos dois lugares ao mesmo tempo."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ícone da bandeja" Style="{StaticResource Title}"/>
                            <TextBlock Text="Disposição das barras" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OrientVertical" GroupName="TrayOrient" Style="{StaticResource Segment}" Content="Vertical (colunas)"/>
                                    <RadioButton x:Name="OrientHorizontal" GroupName="TrayOrient" Style="{StaticResource Segment}" Content="Horizontal (linhas)"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Com duas ou três barras a horizontal costuma ser mais legível em 16 px. Com uma barra só, o ícone mostra a porcentagem em número."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Painel na barra de tarefas" Style="{StaticResource Title}"/>

                            <TextBlock Text="Posição" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TbLeft" GroupName="TbAnchor" Style="{StaticResource Segment}" Content="À esquerda"/>
                                    <RadioButton x:Name="TbRight" GroupName="TbAnchor" Style="{StaticResource Segment}" Content="Junto ao relógio"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Tela" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="TbMonitors" Orientation="Horizontal" MaxWidth="420"/>
                            </Border>
                            <TextBlock x:Name="TbMonitorHint" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distância da borda" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbOffset" Grid.Column="1" Minimum="0" Maximum="400" Value="8"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblTbOffset" Grid.Column="2" Text="8 px" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbScale" Grid.Column="1" Minimum="0.8" Maximum="1.6" Value="1"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblTbScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fundo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbOpacity" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblTbOpacity" Grid.Column="2" Text="0%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <TextBlock Text="Estilo" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="EstiloContorno" GroupName="PanelStyle" Style="{StaticResource Segment}"
                                                 Content="Com contorno"/>
                                    <RadioButton x:Name="EstiloLeve" GroupName="PanelStyle" Style="{StaticResource Segment}"
                                                 Content="Sem contorno"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Com contorno, cada letra ganha um traço escuro em volta e a trilha das barras fica escura com borda clara: lê sobre qualquer papel de parede, inclusive claro. Sem contorno é o visual mais leve, que combina com papel escuro. Vale para os dois painéis da barra e para o indicador no jogo."/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="O Windows 11 não permite embutir componentes na barra de tarefas, então o painel é uma faixa posicionada sobre o espaço livre dela — ele acompanha mudanças de tamanho e some quando um aplicativo em tela cheia está na frente. Fundo em 0% deixa a barra do Windows aparecer atrás."/>
                        </StackPanel>
                    </Border>


                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Painel do computador na barra de tarefas" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Um segundo painel com CPU, GPU e memória, do lado oposto ao da IA — assim cada bloco tem lugar fixo e você nunca confunde qual é qual."/>

                            <CheckBox x:Name="ChkPcPanel" Style="{StaticResource Switch}" Content="Mostrar o painel do computador"/>

                            <TextBlock Text="Lado" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="PcLeft" GroupName="PcAnchor" Style="{StaticResource Segment}" Content="À esquerda"/>
                                    <RadioButton x:Name="PcRight" GroupName="PcAnchor" Style="{StaticResource Segment}" Content="Junto ao relógio"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Tela" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="PcMonitors" Orientation="Horizontal" MaxWidth="420"/>
                            </Border>
                            <TextBlock x:Name="PcMonitorHint" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="O que mostrar" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                            <CheckBox x:Name="ChkPcCpu" Style="{StaticResource Switch}" Content="CPU"/>
                            <CheckBox x:Name="ChkPcCpuSensors" Style="{StaticResource Switch}"
                                      Content="Ler também temperatura e watts da CPU" Margin="27,9,0,0"/>
                            <CheckBox x:Name="ChkPcGpu" Style="{StaticResource Switch}" Content="GPU (uso, temperatura, watts)"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="A GPU entrega tudo sem driver e sem elevação. O uso da CPU e a memória também."/>
                            <CheckBox x:Name="ChkPcRam" Style="{StaticResource Switch}" Content="Memória (uso e GB)"/>
                            <CheckBox x:Name="ChkThemeToggle" Style="{StaticResource Switch}"
                                      Content="Botão de trocar o tema claro/escuro do Windows"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" TextWrapping="Wrap"
                                       Text="Um clique faz o que a página Personalização › Cores faz: troca o modo dos aplicativos e do sistema de uma vez. Com o painel do computador desligado, o botão vai para o painel da IA."/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Leitura a cada" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldPcInterval" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="2" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblPcInterval" Grid.Column="2" Text="2 s" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="9"
                                    Padding="14,11" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ElevationText" Style="{StaticResource Hint}" FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="BtnElevate" Content="Reiniciar como administrador"
                                            Click="OnElevateClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Gadget flutuante" Style="{StaticResource Title}"/>

                            <TextBlock Text="Disposição das barras" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="GadgetVertical" GroupName="GadgetOrient" Style="{StaticResource Segment}" Content="Uma por linha"/>
                                    <RadioButton x:Name="GadgetHorizontal" GroupName="GadgetOrient" Style="{StaticResource Segment}" Content="Lado a lado"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacidade" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.3" Maximum="1" Value="0.95"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="95%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldScale" Grid.Column="1" Minimum="0.7" Maximum="2" Value="1"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <CheckBox x:Name="ChkTopmost" Style="{StaticResource Switch}" Content="Sempre por cima"/>
                            <CheckBox x:Name="ChkLocked" Style="{StaticResource Switch}" Content="Travar posição"/>
                            <CheckBox x:Name="ChkShowReset" Style="{StaticResource Switch}" Content="Mostrar horário de renovação"/>

                            <TextBlock Text="O que mais mostrar" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                            <CheckBox x:Name="ChkGadgetHardware" Style="{StaticResource Switch}"
                                      Content="CPU, GPU e memória"/>
                            <TextBlock x:Name="GadgetHardwareHint" Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       TextWrapping="Wrap"
                                       Text="Um bloco de sensores abaixo dos limites. Quais componentes aparecem são os mesmos escolhidos em “Painel do computador”, e ligar isto liga a leitura de sensores mesmo com aquele painel desligado."/>

                            <CheckBox x:Name="ChkGadgetRate" Style="{StaticResource Switch}"
                                      Content="Velocímetro do ritmo de consumo"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" TextWrapping="Wrap"
                                       Text="O mesmo interruptor que existe em Ritmo — a escala, o limite acompanhado e a janela da média ficam lá."/>

                            <Button Content="Reposicionar no canto inferior direito" Click="OnResetPositionClick"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Ritmo (velocímetro) ============ -->
                <!-- ============ No jogo ============ -->
                <StackPanel x:Name="PanelGame" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Indicadores por cima do jogo" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Escolha a janela do jogo e o app desenha FPS e os sensores por cima dela. A medição de quadros usa o rastreamento do próprio Windows — o mesmo caminho do PresentMon: nada é injetado no jogo e nada é lido da memória dele, que é o que faz anticheat reclamar."/>

                            <CheckBox x:Name="ChkOverlay" Style="{StaticResource Switch}" Content="Mostrar indicadores no jogo"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="O estilo do texto é o mesmo dos painéis da barra — a opção fica em “Painel na barra de tarefas”."/>

                            <TextBlock Text="Qual é o jogo" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Abra o jogo primeiro e escolha a janela dele aqui. Escolher à mão sempre funciona; adivinhar não, porque em janela sem bordas um jogo é indistinguível de qualquer outra janela."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="12,9"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="GameTargetText" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Button x:Name="BtnPickGame" Grid.Column="1" Content="Escolher janela…"
                                        Click="OnPickGameClick" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnClearGame" Grid.Column="2" Content="Limpar"
                                        Click="OnClearGameClick" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <CheckBox x:Name="ChkOverlayNoFocus" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                      Content="Mostrar mesmo quando o jogo não está em primeiro plano"/>

                            <TextBlock Text="Nunca mostrar nestes" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Vale para quando o app está adivinhando. Uma planilha maximizada cobre o monitor igualzinho a um jogo — aqui você diz quais aplicativos devem ser ignorados."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="4" MinHeight="86">
                                    <ListBox x:Name="ListaExcecoes" Background="Transparent" BorderThickness="0"
                                             MaxHeight="130" Foreground="{StaticResource TextBrush}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Button Content="Adicionar…" Click="OnAddExceptionClick" MinWidth="112"/>
                                    <Button x:Name="BtnRemoverExcecao" Content="Remover" Click="OnRemoveExceptionClick"
                                            Margin="0,8,0,0" MinWidth="112"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="OverlayStatus" Background="{StaticResource BgBrush}" CornerRadius="9"
                                    Padding="14,11" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="OverlayStatusText" Style="{StaticResource Hint}" FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="BtnOverlayElevate" Content="Reiniciar como administrador"
                                            Click="OnElevateClick" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Atalhos, para usar dentro da partida" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Funcionam com o jogo em primeiro plano. Clique no botão e pressione a combinação; Esc cancela e Backspace desliga o atalho."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ligar/desligar o bloco" VerticalAlignment="Center" FontSize="12.5"/>
                                <Button x:Name="BtnHotkeyToggle" Grid.Column="1" MinWidth="150"
                                        Click="OnCaptureHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown"
                                        Tag="toggle"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Próximo canto da tela" VerticalAlignment="Center" FontSize="12.5"/>
                                <Button x:Name="BtnHotkeyCycle" Grid.Column="1" MinWidth="150"
                                        Click="OnCaptureHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown"
                                        Tag="cycle"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Alternar o layout" VerticalAlignment="Center" FontSize="12.5"/>
                                <Button x:Name="BtnHotkeyLayout" Grid.Column="1" MinWidth="150"
                                        Click="OnCaptureHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown"
                                        Tag="layout"/>
                            </Grid>
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Layout" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LayoutCompact" GroupName="OvLayout" Style="{StaticResource Segment}"
                                                 Content="Compacto"/>
                                    <RadioButton x:Name="LayoutGauges" GroupName="OvLayout" Style="{StaticResource Segment}"
                                                 Content="Medidores"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Compacto: linhas com número e traçado. Medidores: anéis de porcentagem e termômetro da CPU com o limite em 100 °C — maior, para ler de relance. O atalho de layout alterna entre os dois sem sair do jogo."/>

                            <TextBlock Text="Onde na tela" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="180"
                                         HorizontalAlignment="Left"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distância da borda" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOverlayMargin" Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="2"
                                        IsSnapToTickEnabled="True" Value="18" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOverlayMargin" Grid.Column="2" Text="18 px" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tamanho" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOverlayScale" Grid.Column="1" Minimum="0.7" Maximum="2.5" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" Value="1" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOverlayScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fundo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldOverlayOpacity" Grid.Column="1" Minimum="0.1" Maximum="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" Value="0.7" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblOverlayOpacity" Grid.Column="2" Text="70%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <TextBlock Text="O que mostrar no jogo" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                            <CheckBox x:Name="ChkOvFps" Style="{StaticResource Switch}" Content="FPS"/>
                            <CheckBox x:Name="ChkOvFrameTime" Style="{StaticResource Switch}"
                                      Content="Tempo de quadro e 1% low" Margin="27,9,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="O 1% low é o ritmo nos 1% de quadros mais lentos — é ele que denuncia engasgo que a média esconde."/>
                            <CheckBox x:Name="ChkOvGraphs" Style="{StaticResource Switch}"
                                      Content="Traçado das últimas leituras nos sensores"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" TextWrapping="Wrap"
                                       Text="Escala fixa de 0 a 100%, para que a altura signifique sempre a mesma coisa. A cor acompanha a carga, na mesma régua das barras do painel."/>
                            <CheckBox x:Name="ChkOvCpu" Style="{StaticResource Switch}" Content="CPU"/>
                            <CheckBox x:Name="ChkOvGpu" Style="{StaticResource Switch}" Content="GPU"/>
                            <CheckBox x:Name="ChkOvRam" Style="{StaticResource Switch}" Content="Memória"/>
                            <CheckBox x:Name="ChkOvClaude" Style="{StaticResource Switch}" Content="Limites da assinatura Claude"/>
                            <CheckBox x:Name="ChkOvHotkeys" Style="{StaticResource Switch}"
                                      Content="Rodapé com os atalhos"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" TextWrapping="Wrap"
                                       Text="Uma vez oculto, o bloco não tem como lembrar a combinação que o traz de volta — por isso ela fica à vista antes. Combinação recusada pelo Windows não é anunciada."/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Text="Em janela sem bordas e em tela cheia com as otimizações do Windows ligadas (o padrão no Windows 11) o bloco aparece normalmente. Em tela cheia exclusiva de verdade o jogo é dono da tela e nenhuma janela sobrepõe — nesse caso, alternar o jogo para “tela cheia em janela” resolve."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelRate" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Velocímetro de consumo" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Mostra quanto do limite você está gastando por minuto. O meio da escala é o ritmo que o limite aguenta até renovar: ponteiro à esquerda dele significa que dá para seguir assim, à direita significa que vai acabar antes."/>

                            <CheckBox x:Name="ChkRateTaskbar" Style="{StaticResource Switch}" Content="Mostrar no painel da barra de tarefas"/>
                            <CheckBox x:Name="ChkRateGadget" Style="{StaticResource Switch}" Content="Mostrar no gadget flutuante"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="No ícone da bandeja o ritmo aparece ao passar o mouse — no desenho de 16 px não há espaço."/>

                            <TextBlock Text="Ritmo de qual limite" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,5"
                                       Text="Também dá para trocar clicando no próprio velocímetro, na barra de tarefas ou no gadget — o rótulo ao lado dele mostra qual está ativo."/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RateWeekly" GroupName="RateKind" Style="{StaticResource Segment}" Content="Semanal"/>
                                    <RadioButton x:Name="RateSession" GroupName="RateKind" Style="{StaticResource Segment}" Content="Sessão"/>
                                    <RadioButton x:Name="RateFable" GroupName="RateKind" Style="{StaticResource Segment}" Content="Fable 5"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Calcular a média sobre" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Win5" GroupName="RateWin" Style="{StaticResource Segment}" Content="5 min"/>
                                    <RadioButton x:Name="Win20" GroupName="RateWin" Style="{StaticResource Segment}" Content="20 min"/>
                                    <RadioButton x:Name="Win60" GroupName="RateWin" Style="{StaticResource Segment}" Content="1 hora"/>
                                    <RadioButton x:Name="Win1440" GroupName="RateWin" Style="{StaticResource Segment}" Content="24 horas"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Janela curta reage rápido e oscila; janela longa é estável e demora a perceber mudança de ritmo. Só entra tempo com o app aberto — períodos fechados não contam como consumo zero."/>

                            <CheckBox x:Name="ChkTimeProgress" Style="{StaticResource Switch}"
                                      Content="Mostrar o tempo decorrido da janela junto das barras"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Um fio fino sob cada barra marca quanto já passou até a renovação: se ele está à frente do consumo, você gasta mais devagar que o relógio."/>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="16,13" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl x:Name="RatePreviewHost" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="RatePreviewValue" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RatePreviewCaption" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Barras ============ -->
                <StackPanel x:Name="PanelBars" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Quais barras mostrar" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="O texto à direita é o rótulo exibido. Só aparecem as barras que a API devolver."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="ChkSession" Grid.Row="0" Style="{StaticResource Switch}" Content="Sessão (janela de 5 horas)" Margin="0,9,20,0"/>
                                <TextBox x:Name="TxtSessionLabel" Grid.Row="0" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnAnyTextChanged"/>

                                <CheckBox x:Name="ChkWeekly" Grid.Row="1" Style="{StaticResource Switch}" Content="Semanal (todos os modelos)" Margin="0,9,20,0"/>
                                <TextBox x:Name="TxtWeeklyLabel" Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnAnyTextChanged"/>

                                <CheckBox x:Name="ChkFable" Grid.Row="2" Style="{StaticResource Switch}" Content="Semanal do modelo avançado" Margin="0,9,20,0"/>
                                <TextBox x:Name="TxtFableLabel" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" TextChanged="OnAnyTextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Cores por nível" Style="{StaticResource Title}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Atenção (amarelo)" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldWarn" Grid.Column="1" Minimum="30" Maximum="95" TickFrequency="5"
                                        IsSnapToTickEnabled="True" Value="75" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnWarnChanged"/>
                                <TextBlock x:Name="LblWarn" Grid.Column="2" Text="75%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Alerta (vermelho)" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldAlert" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                                        IsSnapToTickEnabled="True" Value="90" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnAlertChanged"/>
                                <TextBlock x:Name="LblAlert" Grid.Column="2" Text="90%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <CheckBox x:Name="ChkNotify" Style="{StaticResource Switch}"
                                      Content="Avisar com notificação ao atingir o alerta"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Prévia" Style="{StaticResource Title}"/>
                            <StackPanel x:Name="PreviewPanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Conta ============ -->
                <StackPanel x:Name="PanelAccount" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="De onde vem o consumo" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" FontSize="12.5"/>

                            <RadioButton x:Name="SrcClaudeCode" GroupName="Src" Margin="0,14,0,0"
                                         Content="Usar o login do Claude Code (recomendado)" Checked="OnSourceChanged"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="Lê o token de %USERPROFILE%\.claude\.credentials.json. O arquivo do Claude Code nunca é alterado."/>

                            <!--
                                Login dentro do app: mesmo fluxo do `claude setup-token` (OAuth com PKCE).
                                O redirect é a página de código do console, que exibe o código para colar —
                                assim o app não precisa escutar porta nenhuma para receber o callback.
                            -->
                            <RadioButton x:Name="SrcAppLogin" GroupName="Src" Margin="0,14,0,0"
                                         Content="Entrar com a minha conta Claude aqui no app" Checked="OnSourceChanged"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                       Text="Abre o site do Claude, você autoriza e cola o código de volta nesta tela. Serve para quem não tem o Claude Code neste computador. O token fica só aqui, em %APPDATA%\ClaudeIndicator\login.json."/>

                            <StackPanel x:Name="LoginPanel" Margin="27,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnLogin" Content="Abrir o site do Claude"
                                            Style="{StaticResource PrimaryButton}" Click="OnLoginClick"/>
                                    <Button x:Name="BtnLogout" Content="Sair desta conta" Margin="8,0,0,0"
                                            Visibility="Collapsed" Click="OnLogoutClick"/>
                                </StackPanel>

                                <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                               Text="Autorize no site e cole aqui o código que ele mostrar (pode colar a URL inteira da página também)."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCode" FontFamily="Consolas" FontSize="11.5"
                                                 KeyDown="OnCodeKeyDown"/>
                                        <Button x:Name="BtnConnect" Grid.Column="1" Content="Conectar"
                                                Margin="8,0,0,0" Click="OnConnectClick"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="LoginResult" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           MaxWidth="470" Visibility="Collapsed"/>
                            </StackPanel>

                            <RadioButton x:Name="SrcManual" GroupName="Src" Content="Informar um token manualmente"
                                         Margin="0,14,0,0" Checked="OnSourceChanged"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,6"
                                       Text="Gere com `claude setup-token` e cole abaixo."/>
                            <TextBox x:Name="TxtToken" Margin="27,0,0,0" FontFamily="Consolas" FontSize="11.5"
                                     TextChanged="OnAnyTextChanged"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnTest" Content="Testar conexão" Click="OnTestClick"/>
                                <TextBlock x:Name="TestResult" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" MaxWidth="420"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Barra própria ============ -->
                <StackPanel x:Name="PanelDock" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Uma barra de tarefas sua" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="Uma faixa nossa numa borda que o Windows deixou livre, com os painéis do app dentro. O rodapé não é oferecido de propósito: lá já está a barra do Windows, e duas barras na mesma borda só reservam o dobro de espaço."/>

                            <CheckBox x:Name="ChkDock" Style="{StaticResource Switch}" Content="Mostrar a barra própria"/>

                            <TextBlock Text="Borda" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DockTop" GroupName="DockEdge" Style="{StaticResource Segment}"
                                                 Content="No topo" Checked="OnDockEdgeChanged"/>
                                    <RadioButton x:Name="DockLeft" GroupName="DockEdge" Style="{StaticResource Segment}"
                                                 Content="À esquerda" Checked="OnDockEdgeChanged"/>
                                    <RadioButton x:Name="DockRight" GroupName="DockEdge" Style="{StaticResource Segment}"
                                                 Content="À direita" Checked="OnDockEdgeChanged"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Tela" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel x:Name="DockMonitors" Orientation="Horizontal" MaxWidth="420"/>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Qualquer tela serve: a barra própria não depende de haver barra do Windows naquele monitor."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Como ela se comporta" Style="{StaticResource Title}"/>

                            <CheckBox x:Name="ChkDockReserve" Style="{StaticResource Switch}"
                                      Content="Reservar espaço na tela"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="É o que faz dela uma barra de verdade: o Windows tira a faixa da área útil e janela maximizada para nela, em vez de passar por baixo. Desligado, a barra só flutua sobre o que estiver ali."/>

                            <CheckBox x:Name="ChkDockTopmost" Style="{StaticResource Switch}"
                                      Content="Ficar sempre por cima"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Com as duas ligadas, o comportamento é o da barra do Windows: reserva o espaço e ainda fica na frente de quem for arrastado para cima dela."/>

                            <CheckBox x:Name="ChkDockFullscreen" Style="{StaticResource Switch}"
                                      Content="Sair da frente de jogo em tela cheia"/>
                            <TextBlock x:Name="DockFullscreenHint" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tamanho e fundo" Style="{StaticResource Title}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblDockSizeName" Text="Altura" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldDockSize" Grid.Column="1" Minimum="28" Maximum="160" Value="46"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnDockSizeChanged"/>
                                <TextBlock x:Name="LblDockSize" Grid.Column="2" Text="46 px" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fundo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldDockOpacity" Grid.Column="1" Minimum="0" Maximum="1" Value="0.92"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblDockOpacity" Grid.Column="2" Text="92%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Conteúdo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldDockScale" Grid.Column="1" Minimum="0.7" Maximum="1.8" Value="1"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblDockScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <CheckBox x:Name="ChkDockFrosted" Style="{StaticResource Switch}"
                                      Content="Fundo fosco (desfoque do Windows)" Margin="0,14,0,0"/>
                            <TextBlock x:Name="DockFrostedHint" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Fundo em 0% deixa só o conteúdo, sobre o papel de parede ou a janela que estiver atrás. A espessura é em unidades de tela: 46 vale a mesma altura aparente no monitor de 100% e no de 150%."/>

                            <Button x:Name="BtnDockDefaults" Content="Restaurar padrões" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="OnDockDefaultsClick"
                                    ToolTip="Volta espessura, fundo e tamanho do conteúdo aos valores de fábrica."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Os painéis dentro dela" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="Estes interruptores são só desta barra: o mesmo painel pode estar aqui e no espaço livre da barra do Windows ao mesmo tempo, cada um no seu lugar. Quais limites e quais sensores entram continua sendo o que está escolhido em Barras e no painel do computador."/>

                            <CheckBox x:Name="ChkDockBars" Style="{StaticResource Switch}" Content="Painel da assinatura (limites)"/>
                            <TextBlock Text="Lado dele na barra" Style="{StaticResource FieldLabel}" Margin="27,6,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}" Margin="27,0,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DockBarsStart" GroupName="DockBarsSide" Style="{StaticResource Segment}"
                                                 Content="No começo"/>
                                    <RadioButton x:Name="DockBarsEnd" GroupName="DockBarsSide" Style="{StaticResource Segment}"
                                                 Content="No fim"/>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="ChkDockHardware" Style="{StaticResource Switch}" Content="Painel do computador (sensores)"
                                      Margin="0,16,0,0"/>
                            <TextBlock Text="Lado dele na barra" Style="{StaticResource FieldLabel}" Margin="27,6,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}" Margin="27,0,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DockPcStart" GroupName="DockPcSide" Style="{StaticResource Segment}"
                                                 Content="No começo"/>
                                    <RadioButton x:Name="DockPcEnd" GroupName="DockPcSide" Style="{StaticResource Segment}"
                                                 Content="No fim"/>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="ChkDockRate" Style="{StaticResource Switch}" Content="Velocímetro do ritmo"
                                      Margin="0,16,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0" TextWrapping="Wrap"
                                       Text="Ele acompanha o painel da assinatura, como acompanha na barra de tarefas, e diz de qual limite é o ritmo — clicar nele troca."/>

                            <TextBlock x:Name="DockSideHint" Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="A linha do tempo das consultas segue o interruptor em Sistema, e o botão de trocar o tema do Windows vem junto com os sensores. Atalhos de aplicativos ficam para depois."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Barra do Windows ============ -->
                <StackPanel x:Name="PanelTaskbar" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Aparência da barra do Windows" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="No Windows 11 a barra é XAML e pinta o próprio fundo por cima de qualquer efeito pedido à janela. Por isso o app coloca uma DLL dentro do Explorer — o mesmo desenho do TranslucentTB — que deixa esse fundo transparente; só então o efeito pedido ao compositor aparece. Se você tem um programa do gênero rodando, feche: dois mexendo na mesma barra ficam brigando."/>
                            <Border x:Name="TbTapAviso" Visibility="Collapsed" Margin="0,6,0,0" CornerRadius="8" Padding="12,10"
                                    Background="#22E8B04B" BorderBrush="#55E8B04B" BorderThickness="1">
                                <TextBlock x:Name="TbTapTexto" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Efeito" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Border Style="{StaticResource SegmentGroup}">
                                <WrapPanel Orientation="Horizontal" MaxWidth="440">
                                    <RadioButton x:Name="TbLookSistema" GroupName="TbLook" Style="{StaticResource Segment}"
                                                 Content="Não mexer" Checked="OnTaskbarLookChanged"/>
                                    <RadioButton x:Name="TbLookTransparente" GroupName="TbLook" Style="{StaticResource Segment}"
                                                 Content="Transparente" Checked="OnTaskbarLookChanged"/>
                                    <RadioButton x:Name="TbLookDesfocada" GroupName="TbLook" Style="{StaticResource Segment}"
                                                 Content="Desfocada" Checked="OnTaskbarLookChanged"/>
                                    <RadioButton x:Name="TbLookFosca" GroupName="TbLook" Style="{StaticResource Segment}"
                                                 Content="Fosca" Checked="OnTaskbarLookChanged"/>
                                    <RadioButton x:Name="TbLookOpaca" GroupName="TbLook" Style="{StaticResource Segment}"
                                                 Content="Opaca" Checked="OnTaskbarLookChanged"/>
                                </WrapPanel>
                            </Border>
                            <TextBlock x:Name="TbLookHint" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Border x:Name="TbElevadoAviso" Visibility="Collapsed" Margin="0,10,0,0"
                                    CornerRadius="8" Padding="12,10" Background="#22E8B04B"
                                    BorderBrush="#55E8B04B" BorderThickness="1">
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="O app está rodando como administrador. A barra de tarefas é janela do Explorer, que roda sem elevação, e o pedido do efeito pode não alcançá-la de um processo elevado — foi o que os testes indicaram. Se a barra do Windows não mudar, abra o app sem administrador; em troca, a temperatura e os watts da CPU deixam de ser lidos (eles exigem elevação)."/>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tom" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldTbTint" Grid.Column="1" Minimum="0" Maximum="1" Value="0.65"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnTaskbarTintChanged"/>
                                <TextBlock x:Name="LblTbTint" Grid.Column="2" Text="65%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="O tom é a cor do app por cima do efeito: quanto mais alto, mais escura a barra e menos o fundo aparece. Zero é a barra limpa, sem tom. Em &quot;Opaca&quot; o tom não vale — opaca com tom pela metade não seria opaca."/>

                            <CheckBox x:Name="ChkDockFollowTaskbar" Style="{StaticResource Switch}" Margin="0,16,0,0"
                                      Content="A barra própria segue este estilo"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Ligado, as duas barras ficam com o mesmo vidro e o mesmo tom — e os controles de fundo em Barra própria passam a seguir daqui. Desligado, cada uma tem a sua aparência."/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Text="O efeito é reaplicado quando o Windows avisa que recriou a barra (reinício do Explorer), quando as telas mudam e quando o compositor reinicia — por aviso, sem relógio. Vale para as barras de TODAS as telas. Ao desligar ou sair, o app devolve a barra ao desenho do sistema e ainda pede ao shell que se redesenhe, para não deixar a barra pior do que a pegou."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Janelas translucidas ============ -->
                <StackPanel x:Name="PanelGlass" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Janelas translúcidas" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="O efeito daqueles utilitários de antigamente: a janela inteira fica translúcida e dá para ver o que está atrás dela. Diferente do vidro da barra, aqui o conteúdo desbota junto — por isso a opacidade é ajustável, porque uma janela transparente demais não dá para usar. Isto não injeta nada em programa nenhum: é um atributo de janela que o Windows aceita de fora."/>

                            <CheckBox x:Name="ChkGlass" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                      Content="Deixar janelas translúcidas"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacidade" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldGlassOpacity" Grid.Column="1" Minimum="0.25" Maximum="1"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.85"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnAnyChanged"/>
                                <TextBlock x:Name="LblGlassOpacity" Grid.Column="2" Text="85%" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="100% é a janela normal. O mínimo é 25% porque abaixo disso não se lê mais o que está escrito — e a janela continuaria recebendo os cliques, o que é pior do que não ter o efeito."/>

                            <TextBlock Text="Atalho, na janela em foco" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Liga e desliga o efeito só na janela que está na frente, sem mexer na lista. Clique no botão e pressione a combinação; Esc cancela e Backspace desliga o atalho."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Alternar nesta janela" VerticalAlignment="Center" FontSize="12.5"/>
                                <Button x:Name="BtnHotkeyGlass" Grid.Column="1" MinWidth="150"
                                        Click="OnCaptureHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown"
                                        Tag="glass"/>
                            </Grid>
                            <TextBlock x:Name="GlassHotkeyStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Sempre translúcidos" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Estes aplicativos ficam translúcidos sozinhos, inclusive nas janelas que abrirem depois. Guardado pelo nome do executável."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="4" MinHeight="86">
                                    <ListBox x:Name="ListaVidro" Background="Transparent" BorderThickness="0"
                                             MaxHeight="130" Foreground="{StaticResource TextBrush}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Button Content="Adicionar…" Click="OnAddGlassAppClick" MinWidth="112"/>
                                    <Button x:Name="BtnRemoverVidro" Content="Remover" Click="OnRemoveGlassAppClick"
                                            Margin="0,8,0,0" MinWidth="112"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="9" Padding="14,11" Margin="0,12,0,0">
                                <TextBlock x:Name="GlassStatusText" Style="{StaticResource Hint}" FontSize="12.5"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Text="A barra de tarefas e a área de trabalho ficam de fora mesmo sendo do Explorer: a barra tem ajuste próprio em &quot;Barra do Windows&quot;, e a área de trabalho translúcida não mostraria nada atrás. Janelas que já se desenham com transparência também ficam de fora, senão o desenho delas quebraria. Ao desligar a opção ou sair, o app devolve todas ao normal."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Sistema ============ -->
                <StackPanel x:Name="PanelSystem" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Inicialização" Style="{StaticResource Title}"/>
                            <CheckBox x:Name="ChkStartup" Style="{StaticResource Switch}" Content="Iniciar junto com o Windows"/>
                            <CheckBox x:Name="ChkStartHidden" Style="{StaticResource Switch}" Content="Ao iniciar, não abrir esta janela"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Consultas à API" Style="{StaticResource Title}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intervalo mínimo" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldRefresh" Grid.Column="1" Minimum="60" Maximum="900"
                                        TickFrequency="15" IsSnapToTickEnabled="True" Value="120"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="OnRefreshIntervalChanged"/>
                                <TextBlock x:Name="LblRefresh" Grid.Column="2" Text="120 s" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="A cadência é fixa e fiel a este número: uma consulta por intervalo, sempre — mesmo com o consumo parado, mesmo depois de erro. O limite de consultas é da conta inteira e cada sessão do Claude Code aberta consulta o mesmo endpoint, por isso intervalos curtos com várias sessões abertas causam HTTP 429. O app não se pune por isso: ele tenta de novo no ciclo seguinte, e o remédio, se o 429 insistir, é aumentar este intervalo — decisão sua, não dele."/>

                            <CheckBox x:Name="ChkCallTimeline" Style="{StaticResource Switch}"
                                      Content="Mostrar a linha do tempo das consultas"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Dez pontos no gadget, no painel da barra e na barra própria, um por ciclo do intervalo acima: verde respondeu, âmbar levou HTTP 429, vermelho falhou e o ponto apagado é ciclo que fechou sem resposta — consulta que demorou mais que o intervalo. Passar o mouse mostra o horário e o motivo de cada um."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Dados ============ -->
                <StackPanel x:Name="PanelData" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Histórico de consumo" Style="{StaticResource Title}"/>
                            <RadioButton x:Name="KeepForever" GroupName="Retencao"
                                         Content="Guardar todo o histórico (padrão)" Checked="OnRetentionChanged"/>
                            <RadioButton x:Name="KeepDays" GroupName="Retencao"
                                         Content="Apagar registros antigos automaticamente" Checked="OnRetentionChanged"/>

                            <Grid Margin="27,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblRetentionCaption" Text="Manter os últimos" VerticalAlignment="Center" FontSize="12.5"/>
                                <Slider x:Name="SldRetention" Grid.Column="1" Minimum="7" Maximum="730" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="31" VerticalAlignment="Center" Margin="8,0"
                                        ValueChanged="OnRetentionDaysChanged"/>
                                <TextBlock x:Name="LblRetention" Grid.Column="2" Text="31 dias" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>

                            <TextBlock x:Name="HistoryInfo" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Avançado ============ -->
                <StackPanel x:Name="PanelAdvanced" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Diagnóstico" Style="{StaticResource Title}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="O endpoint de uso é interno da Anthropic e pode mudar de nome ou formato. Tudo aqui é ajustável sem recompilar."/>

                            <TextBlock Text="Endpoints consultados (um por linha)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtEndpoints" AcceptsReturn="True" Height="52"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"
                                     TextChanged="OnAnyTextChanged"/>

                            <TextBlock Text="Palavras-chave por barra" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sessão" VerticalAlignment="Center" Grid.Row="0" FontSize="12.5"/>
                                <TextBox x:Name="TxtKwSession" Grid.Row="0" Grid.Column="1" Margin="0,3" TextChanged="OnAnyTextChanged"/>
                                <TextBlock Text="Semanal" VerticalAlignment="Center" Grid.Row="1" FontSize="12.5"/>
                                <TextBox x:Name="TxtKwWeekly" Grid.Row="1" Grid.Column="1" Margin="0,3" TextChanged="OnAnyTextChanged"/>
                                <TextBlock Text="Fable / Opus" VerticalAlignment="Center" Grid.Row="2" FontSize="12.5"/>
                                <TextBox x:Name="TxtKwFable" Grid.Row="2" Grid.Column="1" Margin="0,3" TextChanged="OnAnyTextChanged"/>
                            </Grid>

                            <TextBlock Text="Peso de cada tipo de token no consumo por projeto" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Saída" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtWeightOutput" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Escrita de cache" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtWeightCacheWrite" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                    <TextBlock Text="Leitura de cache" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtWeightCacheRead" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                    <TextBlock Text="Modelos do Fable" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TxtFableModels" Margin="0,3,0,0" TextChanged="OnAnyTextChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Entrada é a referência (peso 1). Estes pesos mudam como o consumo é repartido entre projetos, nunca o total medido."/>

                            <TextBlock Text="Resposta bruta da API" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBox x:Name="TxtRaw" AcceptsReturn="True" IsReadOnly="True" Height="150"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11.5"/>
                            <TextBlock x:Name="DiagInfo" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Atualizações" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" FontSize="12.5"/>

                            <CheckBox x:Name="ChkCheckUpdates" Style="{StaticResource Switch}"
                                      Content="Procurar versão nova automaticamente"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Consulta as releases do repositório no máximo uma vez a cada 6 horas."/>

                            <TextBlock Text="Repositório" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                            <TextBox x:Name="TxtUpdateRepo" FontFamily="Consolas" FontSize="11.5" TextChanged="OnAnyTextChanged"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnCheckUpdate" Content="Procurar agora" Click="OnCheckUpdateClick"/>
                                <Button x:Name="BtnInstallUpdate" Content="Baixar e instalar" Click="OnInstallUpdateClick"
                                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="UpdateResult" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" MaxWidth="360"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Encerrar" Style="{StaticResource Title}"/>
                            <Button Content="Sair do Claude Indicator" Click="OnExitAppClick" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Barra de salvar: só aparece quando há mudança pendente -->
        <Border x:Name="SaveBar" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="26,12,20,12">
            <Grid>
                <TextBlock Text="Há alterações não salvas." VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Descartar" Click="OnCancelClick" Margin="0,0,10,0"/>
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" MinWidth="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
