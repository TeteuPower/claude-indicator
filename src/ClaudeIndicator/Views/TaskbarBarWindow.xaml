<Window x:Class="ClaudeIndicator.Views.TaskbarBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Indicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="False"
        ShowActivated="False"
        FontFamily="Segoe UI">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="VersionItem" IsEnabled="False"/>
            <Separator/>
            <MenuItem Header="Atualizar agora" Click="OnRefreshClick"/>
            <MenuItem Header="Abrir painel…" Click="OnDashboardClick"/>
            <MenuItem Header="Configurações…" Click="OnSettingsClick"/>
            <Separator/>
            <MenuItem Header="Ocultar da barra de tarefas" Click="OnHideClick"/>
            <MenuItem Header="Sair" Click="OnExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- fundo levemente destacado para separar da barra sem brigar com ela -->
    <!-- Folga pequena de propósito: a distância até os ícones do Windows é para ser ajustada no
         "Deslocamento" das configurações, e não ficar embutida aqui num valor que ninguém alcança. -->
    <Border x:Name="Root" Background="#00000000" Padding="4,0" MouseLeftButtonUp="OnClick"
            Cursor="Hand">
        <StackPanel x:Name="ContentRow" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel x:Name="CellsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel x:Name="CallsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="10,0,0,0"/>
        </StackPanel>
    </Border>
</Window>
