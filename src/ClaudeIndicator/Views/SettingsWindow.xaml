<Window x:Class="ClaudeIndicator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Indicator — Configurações"
        Width="660" Height="780"
        MinWidth="560" MinHeight="520"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Closed="OnClosed">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Claude Indicator" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderStatus" Style="{StaticResource Hint}" Text="Carregando consumo…"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Atualizar agora" Click="OnRefreshClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,4">
            <StackPanel>

                <!-- Preview -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Consumo agora" Style="{StaticResource Title}"/>
                        <StackPanel x:Name="PreviewPanel"/>
                    </StackPanel>
                </Border>

                <!-- Exibição -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Como exibir" Style="{StaticResource Title}"/>
                        <RadioButton x:Name="ModeTray" GroupName="Mode" Content="Ícone na barra de tarefas (bandeja do sistema)"/>
                        <RadioButton x:Name="ModeGadget" GroupName="Mode" Content="Gadget flutuante sempre por cima (arrastável)"/>
                        <RadioButton x:Name="ModeBoth" GroupName="Mode" Content="Os dois ao mesmo tempo"/>
                    </StackPanel>
                </Border>

                <!-- Barras -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Quais barras mostrar" Style="{StaticResource Title}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ChkSession" Grid.Row="0" Grid.Column="0" Content="Sessão (janela de 5 horas)"/>
                            <TextBox x:Name="TxtSessionLabel" Grid.Row="0" Grid.Column="1" Margin="10,7,0,0"/>

                            <CheckBox x:Name="ChkWeekly" Grid.Row="1" Grid.Column="0" Content="Consumo semanal (todos os modelos)"/>
                            <TextBox x:Name="TxtWeeklyLabel" Grid.Row="1" Grid.Column="1" Margin="10,7,0,0"/>

                            <CheckBox x:Name="ChkFable" Grid.Row="2" Grid.Column="0" Content="Semanal do modelo mais avançado (Fable 5 / Opus)"/>
                            <TextBox x:Name="TxtFableLabel" Grid.Row="2" Grid.Column="1" Margin="10,7,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="O texto à direita é o rótulo exibido no gadget. Só aparecem as barras que a API devolver."/>
                    </StackPanel>
                </Border>

                <!-- Gadget -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gadget flutuante" Style="{StaticResource Title}"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacidade" VerticalAlignment="Center"/>
                            <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.3" Maximum="1" Value="0.95"
                                    VerticalAlignment="Center" Margin="8,0"
                                    ValueChanged="OnOpacityChanged"/>
                            <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="95%" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho" VerticalAlignment="Center"/>
                            <Slider x:Name="SldScale" Grid.Column="1" Minimum="0.7" Maximum="2" Value="1"
                                    VerticalAlignment="Center" Margin="8,0"
                                    ValueChanged="OnScaleChanged"/>
                            <TextBlock x:Name="LblScale" Grid.Column="2" Text="100%" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>

                        <CheckBox x:Name="ChkTopmost" Content="Sempre por cima de qualquer aplicativo"/>
                        <CheckBox x:Name="ChkLocked" Content="Travar posição (impede arrastar sem querer)"/>
                        <CheckBox x:Name="ChkShowReset" Content="Mostrar horário de renovação em cada barra"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Reposicionar no canto inferior direito" Click="OnResetPositionClick"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Arraste o gadget com o botão esquerdo. Clique com o botão direito sobre ele para atualizar, abrir as configurações ou sair."/>
                    </StackPanel>
                </Border>

                <!-- Conta -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conta Claude" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" FontSize="12.5"/>

                        <RadioButton x:Name="SrcClaudeCode" GroupName="Src" Margin="0,12,0,0"
                                     Content="Usar o login do Claude Code (recomendado)"
                                     Checked="OnSourceChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,0"
                                   Text="Lê o token de %USERPROFILE%\.claude\.credentials.json. Se ainda não fez login, rode `claude` no terminal e entre com sua conta. O arquivo do Claude Code nunca é alterado."/>

                        <RadioButton x:Name="SrcManual" GroupName="Src" Content="Informar um token manualmente"
                                     Checked="OnSourceChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="27,2,0,6"
                                   Text="Gere um token de longa duração com `claude setup-token` e cole abaixo."/>
                        <TextBox x:Name="TxtToken" Margin="27,0,0,0" FontFamily="Consolas" FontSize="11.5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnTest" Content="Testar conexão" Click="OnTestClick"/>
                            <TextBlock x:Name="TestResult" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" MaxWidth="380"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sistema -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sistema" Style="{StaticResource Title}"/>
                        <CheckBox x:Name="ChkStartup" Content="Iniciar junto com o Windows"/>
                        <CheckBox x:Name="ChkStartHidden" Content="Ao iniciar, não abrir esta janela"/>
                        <CheckBox x:Name="ChkNotify" Content="Avisar com notificação quando atingir o limite de alerta"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Atualizar a cada" VerticalAlignment="Center"/>
                            <Slider x:Name="SldRefresh" Grid.Column="1" Minimum="15" Maximum="900"
                                    TickFrequency="15" IsSnapToTickEnabled="True" Value="120"
                                    VerticalAlignment="Center" Margin="8,0" ValueChanged="OnRefreshIntervalChanged"/>
                            <TextBlock x:Name="LblRefresh" Grid.Column="2" Text="120 s" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Atenção (amarelo)" VerticalAlignment="Center"/>
                            <Slider x:Name="SldWarn" Grid.Column="1" Minimum="30" Maximum="95" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Value="75" VerticalAlignment="Center" Margin="8,0"
                                    ValueChanged="OnWarnChanged"/>
                            <TextBlock x:Name="LblWarn" Grid.Column="2" Text="75%" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Alerta (vermelho)" VerticalAlignment="Center"/>
                            <Slider x:Name="SldAlert" Grid.Column="1" Minimum="40" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Value="90" VerticalAlignment="Center" Margin="8,0"
                                    ValueChanged="OnAlertChanged"/>
                            <TextBlock x:Name="LblAlert" Grid.Column="2" Text="90%" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnóstico -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Diagnóstico (avançado)" Style="{StaticResource Title}"/>
                            <Button Content="Mostrar / ocultar" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Padding="10,4" FontSize="11.5" Click="OnToggleDiagClick"/>
                        </Grid>

                        <StackPanel x:Name="DiagPanel" Visibility="Collapsed">
                            <TextBlock Text="Endpoints consultados (um por linha)" Margin="0,4,0,4"/>
                            <TextBox x:Name="TxtEndpoints" AcceptsReturn="True" Height="56"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"/>

                            <TextBlock Text="Palavras-chave por barra (separadas por vírgula)" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sessão" VerticalAlignment="Center" Grid.Row="0"/>
                                <TextBox x:Name="TxtKwSession" Grid.Row="0" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Text="Semanal" VerticalAlignment="Center" Grid.Row="1"/>
                                <TextBox x:Name="TxtKwWeekly" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                <TextBlock Text="Fable / Opus" VerticalAlignment="Center" Grid.Row="2"/>
                                <TextBox x:Name="TxtKwFable" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
                            </Grid>

                            <TextBlock Text="Resposta bruta da API" Margin="0,12,0,4"/>
                            <TextBox x:Name="TxtRaw" AcceptsReturn="True" IsReadOnly="True" Height="180"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11.5"/>
                            <TextBlock x:Name="DiagInfo" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Button Content="Sair do aplicativo" HorizontalAlignment="Left" Click="OnExitAppClick"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="OnCancelClick" Margin="0,0,10,0"/>
                    <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" MinWidth="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
