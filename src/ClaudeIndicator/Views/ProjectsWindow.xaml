<Window x:Class="ClaudeIndicator.Views.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Indicator — Consumo por projeto"
        Width="900" Height="700"
        MinWidth="720" MinHeight="520"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI"
        Closed="OnClosed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Período:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <RadioButton x:Name="PerWeek" GroupName="Per" Content="Semana atual" Margin="10,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="Per24h" GroupName="Per" Content="24 horas" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="Per30d" GroupName="Per" Content="30 dias" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="PerAll" GroupName="Per" Content="Tudo" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Modelos:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ScopeAll" GroupName="Scope" Content="Todos" Margin="10,0,0,0" Checked="OnFilterChanged"/>
                    <RadioButton x:Name="ScopeFable" GroupName="Scope" Content="Só Fable 5" Margin="14,0,0,0" Checked="OnFilterChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resumo do limite -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="20,14,20,7" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="SummaryLine" FontSize="14"/>
                <TextBlock x:Name="SummaryHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Projetos -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="20,0,20,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProjectsTitle" Text="Projetos" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProjectsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Prompts do projeto selecionado -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="20,7,20,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="PromptsTitle" Text="Prompts" Style="{StaticResource Title}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <RadioButton x:Name="SortRecent" GroupName="Sort" Content="Mais recentes" Margin="0,0,14,0" Checked="OnSortChanged"/>
                        <RadioButton x:Name="SortCost" GroupName="Sort" Content="Mais caros" Checked="OnSortChanged"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PromptsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Rodapé -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
                <Button Content="Reler transcrições" HorizontalAlignment="Right" Padding="10,4" FontSize="11.5"
                        Click="OnRescanClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
