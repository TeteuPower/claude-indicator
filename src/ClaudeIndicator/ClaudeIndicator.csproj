<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ClaudeIndicator</RootNamespace>
    <AssemblyName>ClaudeIndicator</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- desabilitado de propósito: WPF + WinForms no mesmo projeto geram ambiguidades -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.6.3</Version>
    <FileVersion>1.6.3.0</FileVersion>
    <AssemblyVersion>1.6.3.0</AssemblyVersion>
    <Product>Claude Indicator</Product>
    <Company>Claude Indicator</Company>
    <AssemblyTitle>Claude Indicator</AssemblyTitle>
    <Description>Indicador de consumo da assinatura Claude para Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
