<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ClaudeIndicator</RootNamespace>
    <AssemblyName>ClaudeIndicator</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- desabilitado de propósito: WPF + WinForms no mesmo projeto geram ambiguidades -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.16.0</Version>
    <FileVersion>2.16.0.0</FileVersion>
    <AssemblyVersion>2.16.0.0</AssemblyVersion>
    <Product>Claude Indicator</Product>
    <Company>Claude Indicator</Company>
    <AssemblyTitle>Claude Indicator</AssemblyTitle>
    <Description>Indicador de consumo da assinatura Claude para Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- A DLL nativa que entra no Explorer (native/ExplorerTap), embutida para ser extraida em
       tempo de execucao: assim o portatil e o instalado funcionam igual. Compilada antes pelo
       build.ps1; sem compilador C++ o app ainda compila, so a aparencia da barra do Windows fica
       indisponivel e a tela avisa. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\native\ExplorerTap\bin\x64\Release\ExplorerTap.dll')">
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\..\native\ExplorerTap\bin\x64\Release\ExplorerTap.dll">
      <LogicalName>ClaudeIndicator.ExplorerTap.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- sensores de CPU/GPU; a parte da CPU depende de driver de kernel e elevacao -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
